{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiralreality.local/schemas/multipolar-scenario.schema.json",
  "title": "MultipolarScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "queries",
    "agents"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "premise": {
          "type": "string"
        },
        "stakes": {
          "type": "string"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "round": {},
              "title": {
                "type": "string"
              },
              "scene": {
                "type": "string"
              },
              "pressure": {
                "type": "string"
              },
              "turn": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domination_cap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_translation_loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_ambiguity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "description": "Optional deterministic seed recorded in run metadata."
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "must_not_emit": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expected_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "baseline": {
          "type": "string",
          "description": "Suggested baseline run mode, such as mock."
        },
        "candidate": {
          "type": "string",
          "description": "Suggested candidate run mode, such as real_llm."
        },
        "compare_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adversarial_drills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "attack",
          "expected_runtime_response"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "attack": {
            "type": "string"
          },
          "expected_runtime_response": {
            "type": "string"
          },
          "must_trigger": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_preserve": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/AgentConfig"
      }
    }
  },
  "$defs": {
    "AgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "ontology",
        "constraints",
        "model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "ontology": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "no_total_state",
            "no_private_state"
          ]
        },
        "trust": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "private_state": {
          "type": "object",
          "description": "Optional local-only state. This must never be emitted as a MeaningCapsule."
        },
        "behavior": {
          "type": "string",
          "description": "Runtime behavior preset used by mock and adversarial experiments."
        },
        "public_projection": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional bounded, public mock projection for Scenario Zoo experiments."
        }
      }
    },
    "ModelSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "mock",
            "openai",
            "local_path",
            "llama_cpp",
            "transformers",
            "openai_compatible",
            "ollama"
          ],
          "description": "local_path auto-selects llama_cpp for .gguf, otherwise transformers."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Local model file path or local model directory. Example: /models/llama-3.1-8b-instruct.Q4_K_M.gguf"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Base URL for openai_compatible or ollama backends."
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Remote/OpenAI-compatible/Ollama model name, or a human-readable local model label."
        },
        "api_key_env": {
          "type": "string",
          "description": "Optional environment variable containing a bearer token, for example OPENAI_API_KEY."
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeout": {
              "type": "number",
              "minimum": 1
            },
            "cost_per_1k_tokens": {
              "type": "number",
              "minimum": 0
            },
            "input_cost_per_1k_tokens": {
              "type": "number",
              "minimum": 0
            },
            "output_cost_per_1k_tokens": {
              "type": "number",
              "minimum": 0
            },
            "n_ctx": {
              "type": "integer",
              "minimum": 1
            },
            "n_gpu_layers": {
              "type": "integer"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "local_path",
                  "llama_cpp",
                  "transformers"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "openai"
                ]
              }
            }
          },
          "then": {
            "required": [
              "model_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "openai_compatible",
                  "ollama"
                ]
              }
            }
          },
          "then": {
            "required": [
              "url",
              "model_name"
            ]
          }
        }
      ]
    }
  }
}
