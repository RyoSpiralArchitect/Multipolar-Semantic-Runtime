{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiralreality.local/schemas/meaning-capsule.schema.json",
  "title": "MeaningCapsule",
  "description": "Bounded semantic projection for multipolar agent routing. A capsule may carry claims, assumptions, refusal state, audit state, and operational metrics, but must not contain total private state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "source_agent",
    "content",
    "intent",
    "context_refs",
    "provenance",
    "confidence",
    "scope",
    "expiry",
    "permissions",
    "constraints",
    "translation_trace",
    "status",
    "refusal",
    "audit",
    "metrics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(capsule|refusal|translated|quarantine|capsule_commitment)_[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_agent": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "$ref": "#/$defs/SemanticContent"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "References to local context graph nodes, never raw memory dumps."
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "contains": {
        "enum": [
          "no_total_state",
          "no_private_state"
        ]
      }
    },
    "translation_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TranslationStep"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "refused",
        "quarantined",
        "expired"
      ]
    },
    "refusal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Refusal"
        }
      ]
    },
    "audit": {
      "$ref": "#/$defs/AuditMetadata"
    },
    "metrics": {
      "$ref": "#/$defs/CapsuleMetrics"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "refusal": {
            "$ref": "#/$defs/Refusal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "quarantined"
          }
        }
      },
      "then": {
        "properties": {
          "audit": {
            "required": [
              "quarantine_reason"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "SemanticContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "ontology",
        "claims",
        "assumptions",
        "unresolved_terms",
        "data"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Bounded public projection text."
        },
        "ontology": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Terms that should remain explicit instead of being collapsed by translation."
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "generation": {
              "$ref": "#/$defs/GenerationDiagnostics"
            }
          }
        }
      }
    },
    "GenerationDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backend": {
          "type": "string"
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "usage_estimated": {
          "type": "boolean"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "source_memory_refs",
        "generation_mode",
        "evidence_refs"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_memory_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "generation_mode": {
          "type": "string",
          "enum": [
            "projected",
            "viewer_injected",
            "viewer_staged",
            "translated",
            "refusal_preservation",
            "other"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_for_agents",
        "valid_contexts",
        "ttl_seconds",
        "risk_level"
      ],
      "properties": {
        "valid_for_agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "valid_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "severe"
          ]
        }
      }
    },
    "Permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_translate",
        "allow_store",
        "allow_rebroadcast",
        "require_human_review",
        "visibility",
        "allowed_agents"
      ],
      "properties": {
        "allow_translate": {
          "type": "boolean"
        },
        "allow_store": {
          "type": "boolean"
        },
        "allow_rebroadcast": {
          "type": "boolean"
        },
        "require_human_review": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "bounded",
            "private"
          ]
        },
        "allowed_agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TranslationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_agent",
        "to_agent",
        "from_ontology",
        "to_ontology",
        "transform",
        "loss",
        "ambiguity",
        "timestamp",
        "notes"
      ],
      "properties": {
        "from_agent": {
          "type": "string"
        },
        "to_agent": {
          "type": "string"
        },
        "from_ontology": {
          "type": "string"
        },
        "to_ontology": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        },
        "loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "explanation",
        "preserved_content",
        "safe_next_steps"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "cannot_translate",
            "must_not_translate",
            "insufficient_context",
            "permission_denied",
            "conflict_preserved",
            "safe_abstention"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "preserved_content": {
          "type": [
            "object",
            "null"
          ]
        },
        "safe_next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AuditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_at",
        "delivered_to",
        "quarantine_reason",
        "intervention_ids"
      ],
      "properties": {
        "received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "delivered_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quarantine_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "intervention_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "CapsuleMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_loss",
        "ambiguity_score",
        "domination_pressure",
        "trust_weight",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd"
      ],
      "properties": {
        "semantic_loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "domination_pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trust_weight": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
